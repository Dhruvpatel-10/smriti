# smriti environment variables
#
# Copy to `.env` and fill in. None are mandatory — the server runs with
# all defaults. Variables here override values in config.toml at startup.
#
# Anything secret (API keys) belongs ONLY in the env, never in config.toml.

# ── Cloud embedder (ADR-016) ─────────────────────────────────────────────────

# Voyage AI API key. Required when embeddings.provider = "voyage" in config.toml.
# Takes precedence over `embeddings.voyage.api_key` if both are set.
# Get one at https://dash.voyageai.com — paid-tier privacy guarantee requires
# a payment method on file (free tier without a card opts in to training).
# VOYAGE_API_KEY=

# ── Server runtime ───────────────────────────────────────────────────────────

# Base data directory. Holds the SurrealKV DB, exports, queue, and cache.
# Default: current working directory at server start.
# KB_DATA_DIR=/home/youruser/.local/share/smriti

# Config directory. Where smriti looks for config.toml.
# Default: current working directory at server start.
# KB_CONFIG_DIR=/home/youruser/.config/smriti

# Queue directory override. Default: <KB_DATA_DIR>/queue (from config.toml).
# KB_QUEUE_DIR=

# Transport mode. "stdio" (default — one process per Claude session) or
# "http" (long-running daemon, multi-session over HTTP/SSE).
# KB_TRANSPORT=stdio

# HTTP port when KB_TRANSPORT=http. Default: 47821.
# KB_HTTP_PORT=47821

# ── Logging ──────────────────────────────────────────────────────────────────

# tracing-subscriber filter. Examples: "info", "smriti=debug,warn",
# "smriti::db::search=trace". Default: "info".
# RUST_LOG=info

# ── Test / development knobs ─────────────────────────────────────────────────

# Bypass write-time dedup. Only honoured in test builds. Production
# binary ignores this.
# SMRITI_DEDUP_DISABLE=1

# ── Bench harness (bench/ crate only — not consumed by the server) ────────────

# Override embedding model used by bench runs. Falls back to config.toml
# value when unset.
# BENCH_EMBEDDING_MODEL=gte-large-en-v1.5-q

# Restrict bench to a comma-separated list of question categories.
# BENCH_CATEGORIES=temporal,causal

# Skip vector retrieval, run BM25-only baseline. "1" enables.
# BENCH_BM25_ONLY=0

# Toggle promise/intent synonym expansion in bench query rewriting. "1" enables.
# BENCH_PROMISE_SYNONYM=0

# Persistent DB directory for bench runs (defaults to a tempdir each run).
# BENCH_DB_DIR=/home/youruser/.cache/smriti-bench

# Concurrency for bench ingest stage. Default: 4.
# BENCH_INGEST_CONCURRENCY=4

# Cap how many memories each bench scenario ingests (debug / smoke).
# BENCH_INGEST_LIMIT=

# Number of recall summaries to print per bench question (debug).
# BENCH_SUMMARY_PREVIEW=0

# Embedding provider for bench. "local" (fastembed, default) or "voyage" (cloud, ADR-016).
# Voyage requires VOYAGE_API_KEY and paid-tier privacy contract.
# BENCH_PROVIDER=local

# Enable Voyage cross-encoder reranker (ADR-017) at recall stage 3.5.
# Requires BENCH_PROVIDER=voyage. "1" enables.
# BENCH_USE_RERANKER=0

# Override reranker model. Default: rerank-2.5-lite.
# BENCH_RERANKER_MODEL=rerank-2.5-lite

# Override sidecar entry path. Default: sidecar/dist/index.js (relative to CWD).
# BENCH_SIDECAR_PATH=sidecar/dist/index.js

# Use Voyage Batch API (/v1/files + /v1/batches) for bench ingest. 33% cheaper,
# 12h SLA. Production write path stays sync. "1" enables.
# BENCH_USE_VOYAGE_BATCH=0

# Enable Claude Agent SDK sidecar (ADR-013) during bench ingest. Without this,
# bench measures raw retrieval quality without LLM-derived typed relations
# or anchor entities. With this, bench measures end-to-end production quality.
# Requires sidecar built (npm install + npm run build in sidecar/). "1" enables.
# BENCH_USE_LLM_SIDECAR=0
